{
    "name": "astral-php/astral-testing",
    "description": "Helpers de test Astral — HttpTestCase, factories, assertions (events / mails / logs)",
    "type": "library",
    "version": "0.1.0",
    "license": "MIT",
    "keywords": [
        "astral",
        "php",
        "testing",
        "phpunit",
        "http",
        "factories"
    ],
    "authors": [
        {
            "name": "astral-php",
            "homepage": "https://github.com/astral-php"
        }
    ],
    "homepage": "https://github.com/astral-php/astral-testing",
    "support": {
        "source": "https://github.com/astral-php/astral-testing",
        "issues": "https://github.com/astral-php/astral-testing/issues"
    },
    "require": {
        "php": "^8.1",
        "astral-php/astral-core": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "AstralTesting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AstralTesting\\Tests\\": "tests/"
        }
    },
    "extra": {
        "astral-testing": {
            "stubs": "stubs",
            "examples": "examples"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
